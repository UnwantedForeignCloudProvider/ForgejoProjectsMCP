# forgejo-projects-mcp — environment variables
# Copy to .env. It is loaded automatically from the current working directory
# (no `source`/`export` needed). Real environment variables already set — and an
# MCP client's own `env` block — take precedence over this file.
#
# Single-quote any value containing special characters ($, !, …) so it is taken
# literally, e.g. FORGEJO_PASSWORD='p@ss$word!' (otherwise `$word` is expanded).

# --- Required: credentials for the Forgejo instance -------------------------
FORGEJO_URL='https://forge.example.com'
FORGEJO_USERNAME='your-username'
FORGEJO_PASSWORD='your-password'

# --- Optional: politeness limits for the (undocumented) web routes ----------
# Bulk/aggregate reads fan out concurrently; these cap and pace requests.
# Max requests in flight at once (default: 8).
FORGEJO_MCP_MAX_CONCURRENCY=8
# Steady-state request rate, requests/second (default: 5).
FORGEJO_MCP_RPS=5

# --- Optional: logging ------------------------------------------------------
# Log level written to stderr: DEBUG | INFO | WARNING | ERROR | CRITICAL
# (default: INFO). stdout is reserved for the MCP/JSON protocol.
FORGEJO_MCP_LOG_LEVEL=INFO

# --- Optional: session cache location ---------------------------------------
# The authenticated session is stored at
#   <config>/forgejo_projects_mcp/storage_state.json
# where <config> is $XDG_CONFIG_HOME if set, otherwise ~/.config (per-OS).
# Set this only if you want to relocate the cache.
# XDG_CONFIG_HOME=/home/you/.config
